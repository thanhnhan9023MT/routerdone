# RouterDone .gitignore
# Dependencies
node_modules/
# KHÔNG có dấu / ở cuối: `node_modules/` chỉ khớp THƯ MỤC. Khi node_modules là một
# SYMLINK (ví dụ trỏ sang cây khác để chạy test) thì nó là FILE → không bị ignore →
# `git add -A` hút cả cây phụ thuộc vào commit (đã xảy ra 2026-08-17: 29.365 đường dẫn).
node_modules
node_modules.*
.pnp
.pnp.*

# Build output
.next/
.next-build-home/
.build-home/
out/
build/
coverage/

# Runtime data
data/
logs/
*.sqlite
*.db
downloads/
screenshots/

# Env files
.env
.env.local
.env.*.local
!.env.example

# Misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
.tmp*/
.tmp*
tests/.tmp*
.vercel
.idea/

# Debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Codekit agent artifacts (private, not for public repo)
.agents/
AGENTS.md
